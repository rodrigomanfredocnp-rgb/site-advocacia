# Netlify: cabeçalhos aplicados a cada arquivo publicado (funciona também no envio por ZIP).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Arquivos do Next com nome versionado (JS, CSS, fontes): guardar por 1 ano.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Fotos e logos: nome fixo, então guardam por 7 dias (troca de foto aparece em até uma semana).
/img/*
  Cache-Control: public, max-age=604800
/brand/*
  Cache-Control: public, max-age=604800
